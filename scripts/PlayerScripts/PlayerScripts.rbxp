{
    "instanceHierarchy": {
        "tree": {
            "$className": "DataModel",
            "StarterPlayer": {
                "$path": "StarterPlayer",
                "StarterPlayerScripts": {
                    "RbxCharacterSounds": {
                        "$className": "LocalScript",
                        "$path": "StarterPlayerScriptsCommon/RbxCharacterSounds.lua",
                        "AtomicBinding": {
                            "$path": "StarterPlayerScriptsCommon/RbxCharacterSounds/AtomicBinding.lua"
                        }
                    }
                },
                "PlayerModule": {
                    "ServerAuthority": {
                        "ServerAuthorityServer": {
                            "$properties": {
                                "Enabled": false
                            }
                        },
                        "ServerAuthorityClient": {
                            "$properties": {
                                "Enabled": false
                            }
                        }
                    },
                    "InputContexts": {
                        "$className": "Folder",
                        "$path": "InputContexts.rbxp"
                    }
                }
            }
        }
    }
}
