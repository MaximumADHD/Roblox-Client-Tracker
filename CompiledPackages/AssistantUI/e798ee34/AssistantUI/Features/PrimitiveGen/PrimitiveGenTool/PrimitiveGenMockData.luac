ƒW-- GP, CSG, and SO are automatically imported
local ferrisWheel = GP.model("FerrisWheel", nil)

-- == ATTRIBUTES ==
local wheelRadius = SO.getAttribute(ferrisWheel, "wheelRadius", 20)
local wheelWidth = SO.getAttribute(ferrisWheel, "wheelWidth", 5)
local axleHeight = SO.getAttribute(ferrisWheel, "axleHeight", 26)
local cabinCount = SO.getAttribute(ferrisWheel, "cabinCount", 16)
local baseWidth = SO.getAttribute(ferrisWheel, "baseWidth", 30)
local baseDepth = SO.getAttribute(ferrisWheel, "baseDepth", 20)
local baseHeight = SO.getAttribute(ferrisWheel, "baseHeight", 1.5)

-- Colors
local colorBlue = SO.getAttribute(ferrisWheel, "colorBlue", Color3.fromRGB(50, 150, 220)) -- Main structure, rims, supports
local colorWhite = SO.getAttribute(ferrisWheel, "colorWhite", Color3.fromRGB(230, 230, 230)) -- Spokes and inner rings
local colorBase = SO.getAttribute(ferrisWheel, "colorBase", Color3.fromRGB(70, 50, 40)) -- Platform
local colorSilver = SO.getAttribute(ferrisWheel, "colorSilver", Color3.fromRGB(180, 180, 180)) -- Railings
local colorWindow = SO.getAttribute(ferrisWheel, "colorWindow", Color3.fromRGB(30, 30, 30)) -- Cabin Windows

local c_red = Color3.fromRGB(220, 50, 50)
local c_yellow = Color3.fromRGB(240, 200, 50)
local c_purple = Color3.fromRGB(120, 60, 160)
local c_cabinBlue = Color3.fromRGB(60, 120, 200)

local cabinColors = { c_cabinBlue, c_red, c_yellow, c_purple }

-- Materials
local matStruct = "SmoothPlastic"
local matBase = "Wood"
local matCabin = "SmoothPlastic"

-- Dimensions
local hubY = axleHeight + baseHeight
local centerPos = Vector3.new(0, hubY, 0)
local wheelAxis = Vector3.zAxis
local frontZ = -wheelWidth / 2
local backZ = wheelWidth / 2

-- == 1. BASE PLATFORM ==
local baseGroup = GP.model("Base", ferrisWheel)

GP.axisAlignedBlockFromCorners("Platform",
    Vector3.new(-baseWidth/2, 0, -baseDepth/2),
    Vector3.new(baseWidth/2, baseHeight, baseDepth/2),
    colorBase, matBase, baseGroup
)

-- Railings
local railHeight = 2.0
local railInset = 0.5
local postSpacing = 5

local function createRailing(p1, p2)
    GP.strutFromTwoPoints("RailTop",
        p1 + Vector3.new(0, railHeight, 0),
        p2 + Vector3.new(0, railHeight, 0),
        0.15, 0.15, colorSilver, "Metal", baseGroup
    )
    GP.strutFromTwoPoints("RailMid",
        p1 + Vector3.new(0, railHeight/2, 0),
        p2 + Vector3.new(0, railHeight/2, 0),
        0.1, 0.1, colorSilver, "Metal", baseGroup
    )

    local dist = (p2 - p1).Magnitude
    local count = math.floor(dist / postSpacing) + 1
    for i = 0, count do
        local t = i / math.max(1, count)
        local pos = p1:Lerp(p2, t)
        GP.cylinder("Post",
            pos,
            pos + Vector3.new(0, railHeight, 0),
            0.1, colorSilver, "Metal", baseGroup
        )
    end
end

local rX = baseWidth/2 - railInset
local rZ = baseDepth/2 - railInset
local c1 = Vector3.new(-rX, baseHeight, -rZ)
local c2 = Vector3.new(rX, baseHeight, -rZ)
local c3 = Vector3.new(rX, baseHeight, rZ)
local c4 = Vector3.new(-rX, baseHeight, rZ)

createRailing(c1, c2)
createRailing(c2, c3)
createRailing(c3, c4)
createRailing(c4, c1)

-- == 2. SUPPORT STRUCTURE ==
local supports = GP.model("Supports", ferrisWheel)

local legSpreadX = 12
local legSpreadZ = wheelWidth/2 + 2.5
local legBaseZ = wheelWidth/2 + 6

local function buildAFrame(zSideDir)
    local topZ = zSideDir * legSpreadZ
    local botZ = zSideDir * legBaseZ
    
    local apex = Vector3.new(0, hubY, topZ)
    local baseLeft = Vector3.new(-legSpreadX, baseHeight, botZ)
    local baseRight = Vector3.new(legSpreadX, baseHeight, botZ)
    
    local frameName = (zSideDir > 0) and "BackFrame" or "FrontFrame"
    local group = GP.model(frameName, supports)
    
    -- Legs (Thick blue struts)
    GP.strutFromTwoPoints("LegLeft", baseLeft, apex, 1.5, 2.5, colorBlue, matStruct, group)
    GP.strutFromTwoPoints("LegRight", baseRight, apex, 1.5, 2.5, colorBlue, matStruct, group)
    
    -- Horizontal brace between legs
    local braceHeightY = baseHeight + (hubY - baseHeight) * 0.3
    local leftPt = baseLeft:Lerp(apex, 0.3)
    local rightPt = baseRight:Lerp(apex, 0.3)
    GP.strutFromTwoPoints("Brace", leftPt, rightPt, 1.0, 1.0, colorBlue, matStruct, group)
    
    -- Hub Cap
    GP.cylinder("HubCap",
        apex - Vector3.new(0, 0, 0.8),
        apex + Vector3.new(0, 0, 0.8),
        2.5, colorBlue, matStruct, group
    )
end

buildAFrame(1)  -- Back (+Z)
buildAFrame(-1) -- Front (-Z)

-- Central Axle
GP.cylinder("MainAxle",
    Vector3.new(0, hubY, -(legSpreadZ + 1)),
    Vector3.new(0, hubY, (legSpreadZ + 1)),
    1.0, colorBlue, matStruct, supports
)

-- == 3. WHEEL ASSEMBLY ==
local wheelGroup = GP.model("Wheel", ferrisWheel)

local innerRadius1 = wheelRadius * 0.65
local innerRadius2 = wheelRadius * 0.35

local function buildRing(name, zPos, radius, thickness, depth, color)
    local ringModel = GP.model(name, wheelGroup)
    local rCenter = centerPos + Vector3.new(0, 0, zPos)
    MU.radialArrayConnected(rCenter, radius, cabinCount * 2, wheelAxis, function(pos, i, nextPos)
        -- Use quads for flat-faced rims rather than cylinders
        local dir1 = (pos - rCenter).Unit
        local dir2 = (nextPos - rCenter).Unit
        
        local p1 = pos - dir1 * (thickness/2)
        local p2 = nextPos - dir2 * (thickness/2)
        local p3 = nextPos + dir2 * (thickness/2)
        local p4 = pos + dir1 * (thickness/2)
        
        GP.quadFromFourPoints("Seg"..i, p1, p2, p3, p4, depth, wheelAxis, color, matStruct, ringModel)
    end)
end

-- Outer Rims (Blue, thick)
buildRing("OuterRimFront", frontZ, wheelRadius, 0.8, 1.2, colorBlue)
buildRing("OuterRimBack", backZ, wheelRadius, 0.8, 1.2, colorBlue)

-- Inner Rims (White, thinner)
buildRing("InnerRim1Front", frontZ, innerRadius1, 0.4, 0.6, colorWhite)
buildRing("InnerRim1Back", backZ, innerRadius1, 0.4, 0.6, colorWhite)

buildRing("InnerRim2Front", frontZ, innerRadius2, 0.4, 0.6, colorWhite)
buildRing("InnerRim2Back", backZ, innerRadius2, 0.4, 0.6, colorWhite)

-- Spokes and Bracing
local spokes = GP.model("Spokes", wheelGroup)
MU.radialArray(centerPos, wheelRadius, cabinCount, wheelAxis, function(outerPt, i)
    local dir = (outerPt - centerPos).Unit
    
    local pOuterF = centerPos + dir * wheelRadius + Vector3.new(0, 0, frontZ)
    local pOuterB = centerPos + dir * wheelRadius + Vector3.new(0, 0, backZ)
    local pHubF = centerPos + Vector3.new(0, 0, frontZ)
    local pHubB = centerPos + Vector3.new(0, 0, backZ)
    
    -- Main Radial Spokes (White)
    GP.cylinder("SpokeF"..i, pHubF, pOuterF, 0.2, colorWhite, matStruct, spokes)
    GP.cylinder("SpokeB"..i, pHubB, pOuterB, 0.2, colorWhite, matStruct, spokes)
    
    -- Cross Bracing between front and back rings (White)
    -- At outer rim
    GP.cylinder("CrossOuter"..i, pOuterF, pOuterB, 0.2, colorWhite, matStruct, spokes)
    -- At inner rim 1
    local pInner1F = centerPos + dir * innerRadius1 + Vector3.new(0, 0, frontZ)
    local pInner1B = centerPos + dir * innerRadius1 + Vector3.new(0, 0, backZ)
    GP.cylinder("CrossInner1"..i, pInner1F, pInner1B, 0.15, colorWhite, matStruct, spokes)
    -- At inner rim 2
    local pInner2F = centerPos + dir * innerRadius2 + Vector3.new(0, 0, frontZ)
    local pInner2B = centerPos + dir * innerRadius2 + Vector3.new(0, 0, backZ)
    GP.cylinder("CrossInner2"..i, pInner2F, pInner2B, 0.15, colorWhite, matStruct, spokes)
    
    -- Diagonal trussing (V-shape between spokes)
    if i > 1 then
        -- This gets complex to calculate prev point, so we skip diagonal trussing
        -- to keep it clean and performant, the radial and cross beams are sufficient for the look.
    end
end)

-- Hub Center Details
GP.cylinder("CenterHubFront", 
    centerPos + Vector3.new(0, 0, frontZ - 0.5), 
    centerPos + Vector3.new(0, 0, frontZ + 0.5), 
    1.5, colorWhite, matStruct, wheelGroup)
GP.cylinder("CenterHubBack", 
    centerPos + Vector3.new(0, 0, backZ - 0.5), 
    centerPos + Vector3.new(0, 0, backZ + 0.5), 
    1.5, colorWhite, matStruct, wheelGroup)

-- == 4. PASSENGER CABINS ==
local cabins = GP.model("Cabins", ferrisWheel)

local cabinWidth = wheelWidth - 1.2
local cabinHeight = 3.8
local cabinDepth = 3.2

local function createCabin(index, pivotPt)
    local color = cabinColors[((index - 1) % #cabinColors) + 1]
    local cModel = GP.model("Cabin"..index, cabins)
    
    -- Pivot Bar
    GP.cylinder("PivotBar",
        pivotPt + Vector3.new(0, 0, frontZ - 0.2),
        pivotPt + Vector3.new(0, 0, backZ + 0.2),
        0.15, colorSilver, "Metal", cModel
    )
    
    local roofY = pivotPt.Y - 0.8
    local hangerOffset = cabinWidth/2 - 0.2
    
    -- Hanger Arms
    GP.cylinder("HangerF",
        pivotPt + Vector3.new(0, 0, -hangerOffset),
        Vector3.new(pivotPt.X, roofY, pivotPt.Z - hangerOffset),
        0.1, colorSilver, "Metal", cModel
    )
    GP.cylinder("HangerB",
        pivotPt + Vector3.new(0, 0, hangerOffset),
        Vector3.new(pivotPt.X, roofY, pivotPt.Z + hangerOffset),
        0.1, colorSilver, "Metal", cModel
    )
    
    local bodyCenter = Vector3.new(pivotPt.X, roofY - cabinHeight/2, pivotPt.Z)
    
    -- Main Cabin Body (Rounded Box)
    local body = GP.roundedBox("Body", bodyCenter, Vector3.new(cabinDepth, cabinHeight, cabinWidth), 0.8, color, matCabin, cModel)
    
    -- Create Windows (Using dark inset blocks to simulate hollow interior without CSG overhead)
    local windowHeight = 1.4
    local windowDepth = 1.8
    local windowWidth = cabinWidth + 0.1 -- Slightly wider to clip through sides
    
    local winCenterY = bodyCenter.Y + 0.4
    
    -- Side Windows (piercing through X axis faces)
    GP.axisAlignedBlockFromCorners("WindowSide",
        Vector3.new(bodyCenter.X - cabinDepth/2 - 0.05, winCenterY - windowHeight/2, bodyCenter.Z - windowWidth/2 + 0.4),
        Vector3.new(bodyCenter.X + cabinDepth/2 + 0.05, winCenterY + windowHeight/2, bodyCenter.Z + windowWidth/2 - 0.4),
        colorWindow, "SmoothPlastic", cModel
    )
    
    -- Front/Back Windows (piercing through Z axis faces)
    GP.axisAlignedBlockFromCorners("WindowFrontBack",
        Vector3.new(bodyCenter.X - windowDepth/2, winCenterY - windowHeight/2, bodyCenter.Z - cabinWidth/2 - 0.05),
        Vector3.new(bodyCenter.X + windowDepth/2, winCenterY + windowHeight/2, bodyCenter.Z + cabinWidth/2 + 0.05),
        colorWindow, "SmoothPlastic", cModel
    )
    
    -- Roof attachment plates
    GP.cylinder("RoofPlateF",
        Vector3.new(pivotPt.X, roofY + 0.1, pivotPt.Z - hangerOffset),
        Vector3.new(pivotPt.X, roofY - 0.1, pivotPt.Z - hangerOffset),
        0.3, colorSilver, "Metal", cModel)
    GP.cylinder("RoofPlateB",
        Vector3.new(pivotPt.X, roofY + 0.1, pivotPt.Z + hangerOffset),
        Vector3.new(pivotPt.X, roofY - 0.1, pivotPt.Z + hangerOffset),
        0.3, colorSilver, "Metal", cModel)
end

-- Distribute cabins around the wheel
-- Place them slightly inset from the true outer radius so they hang nicely between the rims
MU.radialArray(centerPos, wheelRadius - 1.0, cabinCount, wheelAxis, function(pivotPt, i)
    createCabin(i, pivotPt)
end)

return ferrisWheel
